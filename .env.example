# gemini | groq | openai | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: override the provider's default model
# LLM_MODEL=

# true = scripted AI replies, no key needed (also automatic when the key above is empty)
DEMO_MODE=false

# Only for `python -m reviewer pr owner/repo#12`: a token with pull request access
GITHUB_TOKEN=

# Review settings
MAX_COMMENTS=10
# never | critical | warning | suggestion | nit
FAIL_ON=never
